<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Title -->
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quotation Preview"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Raw Voice -->
        <TextView
            android:id="@+id/rawVoiceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voice Input"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txtRawVoice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@android:color/darker_gray"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/rawVoiceTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Client -->
        <TextView
            android:id="@+id/clientTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Client Name"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/txtRawVoice"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txtClient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/clientTitle"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Service -->
        <TextView
            android:id="@+id/serviceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Service / Scope"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/txtClient"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txtService"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/serviceTitle"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Amount -->
        <TextView
            android:id="@+id/amountTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Amount"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/txtService"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txtAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/amountTitle"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Advance -->
        <TextView
            android:id="@+id/advanceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Advance Payment"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/txtAmount"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txtAdvance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android.textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/advanceTitle"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Delivery -->
        <TextView
            android:id="@+id/deliveryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delivery Timeline"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/txtAdvance"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txtDelivery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/deliveryTitle"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Confirm Button -->
        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Confirm &amp; Generate PDF"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/txtDelivery"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
